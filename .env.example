OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-5.6
DIRECT_QUOTE_CONFIDENCE_THRESHOLD=85
INTERNAL_ACCESS_TOKEN=replace_with_a_long_random_internal_token
GOOGLE_SPREADSHEET_ID=expected_spreadsheet_id
GOOGLE_SHEET_TAB=expected_worksheet_name
GOOGLE_SERVICE_ACCOUNT_JSON=redacted_service_account_json_with_escaped_newlines

# Private estimate history: opt-in only; never enable public mode before setup/review.
PRICER_HISTORY_ENABLED=false
PRICER_PUBLIC_CUSTOMERS_ENABLED=false
PRICER_DAILY_LIMIT_ENABLED=false
PRICER_DAILY_ALLOWANCE=3
PRICER_MAX_ANALYSIS_REVISIONS=8
PRICER_DATABASE_URL=
PRICER_VISITOR_SECRET=
BLOB_READ_WRITE_TOKEN=
PRICER_BLOB_PRIVATE_CONFIRMED=false
# Only after the existing internal credential is confirmed restricted to staff.
PRICER_INTERNAL_AUTH_IS_STAFF=false
